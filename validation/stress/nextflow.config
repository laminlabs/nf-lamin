plugins {
  // Uses the locally installed plugin (see validation/run_stress.sh: make install).
  id 'nf-lamin'
}

manifest {
  name = 'nf-lamin stress test'
  description = 'Mints many artifacts cheaply to load-test the Lamin API'
  nextflowVersion = '>=25.10.0'
  mainScript = 'main.nf'
}

lamin {
  // Track every generated .bin file as an output artifact.
  output_artifacts {
    rules {
      artifacts {
        pattern = '.*\\.bin'
        order = 1
        type = 'include'
      }
    }
  }
}
