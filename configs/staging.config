lamin {
  api_key = secrets.LAMIN_STAGING_API_KEY

  project_uids = ["+nf-lamin-test-project"]
  branch_uid = "+nf-lamin-test-branch"
  ulabel_uids = ["+nf-lamin-test-ulabel"]
}

aws {
  accessKey = secrets.LAMIN_TEST_AWS_ACCESS_KEY_ID
  secretKey = secrets.LAMIN_TEST_AWS_SECRET_ACCESS_KEY
  client {
    // nf-core pipelines set aws.client.anonymous=true for public igenomes/test data,
    // which forces unsigned S3 requests and breaks writes to our private bucket.
    anonymous = false
  }
}
