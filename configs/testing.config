plugins {
  id 'nf-lamin@0.8.3'
}

lamin {
  api_key = secrets.LAMIN_API_KEY
  // api_key = secrets.LAMIN_STAGING_API_KEY
  // env = "staging"
  project_uids = ["?nf-lamin-test-project"]
  branch_uid = "?nf-lamin-test-branch"
  ulabel_uids = ["?nf-lamin-test-ulabel"]
  // space_uid = "?nf-lamin-test-space"
  output_artifacts {
    rules {
      output {
        pattern = ".*"
        order = 1
        type = "include"
      }
      // don't publish state.yaml files
      yaml {
        pattern = ".*\\.state\\.yaml"
        type = "exclude"
        order = 10
      }
    }
  }
}

report {
  enabled = true
  overwrite = true
  file = "report.html"
}

aws {
  accessKey = secrets.LAMIN_TEST_AWS_ACCESS_KEY_ID
  secretKey = secrets.LAMIN_TEST_AWS_SECRET_ACCESS_KEY
  client {
    anonymous = false
  }
}
